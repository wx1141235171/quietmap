name: CREATEAPK

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 45

    env:
      KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
      KS_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
      KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
      KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Install Android SDK packages
        run: |
          set -euo pipefail
          SDK_ROOT="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-/usr/local/lib/android/sdk}}"
          SDKM="$(command -v sdkmanager || true)"
          [ -n "$SDKM" ] || SDKM="$SDK_ROOT/cmdline-tools/latest/bin/sdkmanager"
          yes | "$SDKM" --licenses >/dev/null 2>&1 || true
          # 带小版本号的包名不存在时回退
          "$SDKM" "platforms;android-37.0" "build-tools;37.0.0" \
            || "$SDKM" "platforms;android-37" "build-tools;37.0.0"
          echo "SDK_ROOT=$SDK_ROOT" >> "$GITHUB_ENV"

      - name: Create platforms/android-37 fallback symlink
        run: |
          set -euo pipefail
          if [ ! -e "$SDK_ROOT/platforms/android-37" ] \
             && [ -d "$SDK_ROOT/platforms/android-37.0" ]; then
            ln -s android-37.0 "$SDK_ROOT/platforms/android-37"
            echo "Created symlink android-37 -> android-37.0"
          fi
          ls -l "$SDK_ROOT/platforms"

      - name: Decode release keystore
        if: env.KEYSTORE_BASE64 != ''
        run: |
          set -euo pipefail
          echo "$KEYSTORE_BASE64" | base64 -d > "$RUNNER_TEMP/release.jks"
          ls -l "$RUNNER_TEMP/release.jks"

      - name: Build debug + release
        run: |
          set -euo pipefail
          chmod +x gradlew || true
          ./gradlew test assembleDebug assembleRelease --stacktrace

      - name: Repo mount checks
        run: |
          set -euo pipefail
          if [ -f tools/check-mounts.sh ]; then
            bash tools/check-mounts.sh
          else
            echo "tools/check-mounts.sh 不存在，跳过"
          fi

      - name: Zipalign + sign release APK
        if: env.KEYSTORE_BASE64 != ''
        run: |
          set -euo pipefail
          BT="$SDK_ROOT/build-tools/37.0.0"
          UNSIGNED=$(find app/build/outputs/apk/release -name "*-unsigned.apk" -print -quit || true)
          if [ -z "$UNSIGNED" ]; then
            echo "没有 unsigned APK（Gradle 可能已自行签名），跳过"
            exit 0
          fi
          "$BT/zipalign" -p -f 4 "$UNSIGNED" "$RUNNER_TEMP/aligned.apk"
          "$BT/apksigner" sign \
            --ks "$RUNNER_TEMP/release.jks" \
            --ks-pass "pass:$KS_PASSWORD" \
            --key-pass "pass:$KEY_PASSWORD" \
            --ks-key-alias "$KEY_ALIAS" \
            --out "app/build/outputs/apk/release/app-release-signed.apk" \
            "$RUNNER_TEMP/aligned.apk"
          "$BT/apksigner" verify --print-certs \
            app/build/outputs/apk/release/app-release-signed.apk

      - name: Upload APKs
        uses: actions/upload-artifact@v4
        with:
          name: apk-${{ github.run_number }}-${{ github.sha }}
          path: |
            app/build/outputs/apk/debug/*.apk
            app/build/outputs/apk/release/*.apk
          if-no-files-found: warn
          retention-days: 14

      - name: Upload test / lint / mapping
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: reports-${{ github.run_number }}
          path: |
            app/build/reports/tests
            app/build/reports/lint-results*
            app/build/outputs/mapping
          if-no-files-found: warn
          retention-days: 14
